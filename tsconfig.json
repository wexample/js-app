{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@wexample/js-app": [
        "./src"
      ],
      "@wexample/js-app/*": [
        "./src/*"
      ],
      "@wexample/js-helpers": [
        "../js-helpers/src"
      ],
      "@wexample/js-helpers/*": [
        "../js-helpers/src/*"
      ],
      "@wexample/js-pseudocode": [
        "../js-pseudocode/src"
      ],
      "@wexample/js-pseudocode/*": [
        "../js-pseudocode/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}